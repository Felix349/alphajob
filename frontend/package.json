    "@fullcalendar/react": "^7.1.3",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "geist": "^1.9.0",
    "lucide-react": "^1.67.0",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "shadcn": "^4.23.0",
