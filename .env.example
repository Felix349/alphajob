# 复制本文件为 .env 并按需修改：cp .env.example .env
# .env 已被 .gitignore 忽略，真实密钥只放在 .env 里

# ---- 运行环境 ----
APP_ENV=development

# ---- 数据库（docker-compose.yml 也读取这几项）----
# 注意：主机名用 127.0.0.1 而不是 localhost。Windows 上 localhost 会先走 IPv6，
# 而 Docker Desktop 的 IPv6 端口转发可能连不通，导致连接卡住。
POSTGRES_USER=alphajob
POSTGRES_PASSWORD=alphajob_dev_password
POSTGRES_DB=alphajob
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://alphajob:alphajob_dev_password@127.0.0.1:5432/alphajob
# 测试专用数据库（由 docker/postgres/init 脚本自动创建）
TEST_DATABASE_URL=postgresql+asyncpg://alphajob:alphajob_dev_password@127.0.0.1:5432/alphajob_test

# ---- Redis ----
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# ---- 认证 ----
# 生成方法：uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
# 本地 http 开发时为 false；上线 https 后改为 true
COOKIE_SECURE=false

# ---- 前端 ----
CORS_ORIGINS=http://localhost:3000

# ---- 大模型（W2 开始使用）----
# 默认服务商：deepseek / qwen / openai / anthropic
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Claude（可选，开发调试用）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI（可选；使用时需同时填写模型名）
OPENAI_API_KEY=
OPENAI_MODEL=
# 通义千问使用下方的 DASHSCOPE_API_KEY
QWEN_MODEL=qwen-plus
# ---- 语音转写（W4 开始使用）----
DASHSCOPE_API_KEY=
# 可选：百炼工作空间 ID。配置后走工作空间专属网关，更稳定
DASHSCOPE_WORKSPACE=
ASR_MODEL=paraformer-realtime-v2
